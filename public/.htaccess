# MADAMOON — réglages Apache pour l'hébergement Hostinger.
#
# Le site est un export statique : chaque page est un dossier qui porte
# son index.html. Apache les sert tels quels ; ce fichier n'ajoute que
# ce qu'il ne devine pas — le HTTPS, les types des images modernes, la
# durée de cache et la page 404 du site.

# ————————————————————————————————— HTTPS, une seule adresse —————
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Une seule forme du domaine : sans « www ». Les deux mèneraient au même
# site mais compteraient comme deux adresses pour Google.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ————————————————————————————————— l'ancien site —————
#
# madamoon.fr portait un WordPress de cinq pages. Le nouveau site ne
# garde aucune de ses adresses : sans ces redirections, les liens que la
# maison a semés depuis des années — Instagram, annuaires, Google —
# tomberaient tous sur une page introuvable le jour du basculement, et
# l'ancienneté acquise par ces adresses serait perdue.
#
# En 301, permanent : c'est ce qui transmet le classement à la nouvelle
# adresse. Posées avant la règle 404, et avant tout le reste, pour que
# rien d'autre ne les devance.
#
#   ancienne adresse            nouvelle
#   /votre-morphologie/     →   /morphologies/
#   /catalogue-des-robes/   →   /robes/
#   /prise-de-rendez-vous/  →   /rendez-vous/
#   /faq/                   →   /a-propos/   (à revoir : voir plus bas)
#
# La racine ne bouge pas, elle reste la racine.
#
# Le cas de « /faq/ » n'est pas tranché. Le nouveau site n'a pas de page
# de questions : celles de la maison — délais, essayages, paiement,
# showroom — sont écrites dans le code mais ne paraissent nulle part,
# sinon dans la bouche d'Élise. « /a-propos/ » est le moins mauvais
# refuge en attendant ; une vraie page de questions serait mieux, et le
# contenu existe déjà.
RedirectMatch 301 ^/votre-morphologie/?$ https://madamoon.fr/morphologies/
RedirectMatch 301 ^/catalogue-des-robes/?$ https://madamoon.fr/robes/
RedirectMatch 301 ^/prise-de-rendez-vous/?$ https://madamoon.fr/rendez-vous/
RedirectMatch 301 ^/faq/?$ https://madamoon.fr/a-propos/

# Les restes du WordPress : son administration, ses dossiers internes et
# les adresses de son greffon de boutique. Elles n'existeront plus, mais
# les robots les demanderont encore longtemps. On les renvoie à
# l'accueil plutôt que de laisser quatre cents pages d'erreur s'accumuler
# dans la Search Console.
RedirectMatch 301 ^/(wp-admin|wp-login\.php|wp-content|wp-includes|product|cart|checkout)(/.*)?$ https://madamoon.fr/

# ————————————————————————————————— la page introuvable —————
ErrorDocument 404 /404.html

# ————————————————————————————————— les types de fichiers —————
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ————————————————————————————————— la durée de cache —————
<IfModule mod_expires.c>
  ExpiresActive On
  # Les fichiers de Next portent leur empreinte dans leur nom : ils ne
  # changent jamais sans changer d'adresse.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|mp4|pdf)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>
  # Le HTML, lui, doit pouvoir changer le jour d'une mise à jour.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 10 minutes"
  </FilesMatch>
</IfModule>

# ————————————————————————————————— la compression —————
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ————————————————————————————————— quelques garde-fous —————
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
