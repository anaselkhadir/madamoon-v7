# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fichiers de travail : sauvegardes et rendus intermédiaires.
/travail
outils/__pycache__/

# Dossiers de travail d’un autre chantier, déposés ici par erreur.
.build-*/

# Le relevé de relecture, refait à la demande.
relecture-anglaise.json

# La présentation : les scripts sont versionnés, pas les images ni le fichier.
presentation/captures/
presentation/mockups/
presentation/images/
presentation/node_modules/
presentation/*.pptx
presentation/ql/
presentation/travail/
presentation/.venv/
